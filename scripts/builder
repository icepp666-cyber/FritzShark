#!/bin/bash

# ──────────────────────────────────────────────
# 🚫 BLOCK: Deny direct execution (only via install.sh)
# ──────────────────────────────────────────────
if [[ "${HELLO:-0}" != "1" ]]; then
    echo "❌ Do not run this script directly."
    echo "   Use the launcher script: ./install.sh"
    exit 1
fi
# ──────────────────────────────────────────────
# 🔁 Decide install or reconfig
# ──────────────────────────────────────────────
CONFIG_FILE="$HOME/.config/FritzShark/config.env"
pimpili=0
if [[ -f "$CONFIG_FILE" ]]; then
    echo "🧰 Reconfiguring, ~/.config/FritzShark/config.env exist."
    workdir="$WORK_DIR"
    pimpili=1
else
# ──────────────────────────────────────────────
# 🔐 Request root privileges (for package installs)
# ──────────────────────────────────────────────
    sudo -v

# ──────────────────────────────────────────────
# 📁 Determine working directories
# ──────────────────────────────────────────────
    workdir="$(dirname "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)")"
    inst_dir="$(dirname "$workdir")"

    echo "────────────────"
    echo "[FritzShark 1.1]"
    echo "────────────────"
    echo "Installing in: $inst_dir/"
    echo ""

# ──────────────────────────────────────────────
# 🧱 Create config directory & file
# ──────────────────────────────────────────────
    mkdir -p "$HOME/.config/FritzShark" &> /dev/null
    if ! touch "$HOME/.config/FritzShark/config.env" > /dev/null 2>&1; then
        echo "✖ Failed to create config file '~/.config/FritzShark/config.env'. Aborting."
        exit 1
    fi

# ──────────────────────────────────────────────
# 🔄 Update system packages
# ──────────────────────────────────────────────
    echo "[✓] Updating system packages..."
    sudo apt-get update > /dev/null && sudo apt-get upgrade -y > /dev/null

# ──────────────────────────────────────────────
# 🐍 Check for Python3
# ──────────────────────────────────────────────
    if ! command -v python3 &> /dev/null; then
        echo "[i] Python3 not found, installing..."
        sudo apt-get install -y python3 > /dev/null
    else
        echo "[✓] Python3 version: $(python3 --version)"
    fi

# ──────────────────────────────────────────────
# 🌐 Check for curl
# ──────────────────────────────────────────────
    if ! command -v curl &> /dev/null; then
        echo "[i] curl not found, installing..."
        sudo apt-get install -y curl > /dev/null
    else
        echo "[✓] curl version: $(curl --version | head -n1 | cut -d' ' -f1-4)"
    fi

# ──────────────────────────────────────────────
# 🦈 Check for tshark
# ──────────────────────────────────────────────
    if ! command -v tshark &> /dev/null; then
        echo "[i] tshark not found, installing..."
        sudo apt-get install -y tshark > /dev/null
    else
        echo "[✓] tshark version: $(tshark --version | head -n1)"
    fi

# ──────────────────────────────────────────────
# 🔗 Install launcher
# ──────────────────────────────────────────────
    chmod +x "$workdir/scripts/fritzbox-capture"
    chmod +x "$workdir/fritzyshark-auto"
    sudo ln -sf "$workdir/fritzyshark-auto" /usr/local/bin/fritzshark
fi

# ──────────────────────────────────────────────
# 🔐 Configure HTTPS / HTTP mode
# ──────────────────────────────────────────────
echo "    ────────────────────────────────────────────────────────────"
read -e -p "Enter path to CA certificate (or leave blank for HTTP/HTTPS with public cert): " cert
echo ""

if [ -z "$cert" ]; then
    cp "$workdir/scripts/fritzysid-http.py" "$workdir/scripts/fritzysid.py"
    echo "HTTP mode, no certificate required."
else
    cp "$workdir/scripts/fritzysid-https.py" "$workdir/scripts/fritzysid.py"
    echo "HTTPS mode, using CA certificate from: $cert"
fi

# ──────────────────────────────────────────────
# 👤 Prompt for FritzBox credentials
# ──────────────────────────────────────────────
echo "────────────────────────────────────────────────────────────"
echo ""
echo "    You can use your own FritzBox user or create a dedicated one."
echo "⚠️  Using default credentials is not recommended."
echo ""

while true; do
    read -p "Username [Shark]: " user
    read -p "Password [Shark666]: " pass

    user=${user:-Shark}
    pass=${pass:-Shark666}

    echo -n "Checking credentials... "
    export FRITZBOX_USER="$user"
    export FRITZBOX_PASS="$pass"

    sid="$(python3 "$workdir/scripts/fritzysid.py")"

    if [[ "$sid" == "0000000000000000" || -z "$sid" ]]; then
        echo -ne "✖ Invalid username or password. Please try again.  \n"
    else
        echo -ne "✔ Credentials accepted.                            \n"
        break
    fi
done

# ──────────────────────────────────────────────
# 🌐 FritzBox IP and Capture Filter
# ──────────────────────────────────────────────
read -p "FritzBox IP [192.168.178.1]: " ip
echo "Capture filters help you select traffic to record."
echo "If you're unsure, visit: https://wiki.wireshark.org/CaptureFilters"
read -p "Capture filter (default: not HTTP/HTTPS): " filter

ip=${ip:-192.168.178.1}
filter=${filter:-not (port 80 or port 443)}

# ──────────────────────────────────────────────
# 🧾 Save configuration
# ──────────────────────────────────────────────
cat > "$HOME/.config/FritzShark/config.env" <<EOF
WORK_DIR="$workdir"
FRITZBOX_IP="$ip"
FRITZBOX_USER="$user"
FRITZBOX_PASS="$pass"
CERT_PATH="$cert"
CAPTURE_FILTER="$filter"
EOF
echo "[✓] Config saved: ~/.config/FritzShark/config.env"
echo ""
if [[ "$pimpili" == "1" ]]; then
    echo "Carry on ."
else
# ──────────────────────────────────────────────
# 📢 PATH check hint
# ──────────────────────────────────────────────
    if [[ ":$PATH:" != *":$PWD:"* ]]; then
        echo "[i] Tip: If needed, add current dir to PATH:"
        echo "    export PATH=\$PATH:$PWD"
    fi
# ──────────────────────────────────────────────
# ✅ All done
# ──────────────────────────────────────────────
    echo ""
    echo "[✓] Installation complete."
    echo ""
    echo "Usage:"
    echo "  fritzshark <runtime> <interface>"
    echo ""
    echo "Examples:"
    echo "  fritzshark 120 1-wifi0   # 2-minute capture on Wi-Fi interface"
    echo "  fritzshark 900 2-1       # 15-minute capture on active Internet interface"
    echo ""
    echo "Tip:"
    echo "  Interface mapping table:"
    echo "  https://github.com/jpluimers/fritzcap/blob/master/fritzcap-interfaces-table.md"
    echo ""
fi
